# Nombre público de la aplicación (usado en metadatos/branding)
NEXT_PUBLIC_APP_NAME=REPTILES_RPG

# --- Supabase (requerido) ---
# Project Settings -> API Keys en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta / service_role — SOLO servidor, nunca en código de cliente.
# Necesaria para scripts/seed.ts y para el panel /admin.
SUPABASE_SECRET_KEY=

# Contraseña simple para proteger /admin. Elige la tuya.
ADMIN_PASSWORD=

# APIs públicas usadas por lib/services/images.ts y taxonomy.ts para obtener
# fotografías reales y validar taxonomía a partir del nombre científico. Son
# endpoints públicos sin clave de API: las variables existen para poder apuntar
# a un mirror propio o a un proxy sin tocar el código.
NEXT_PUBLIC_WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1/page/summary
NEXT_PUBLIC_WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
NEXT_PUBLIC_INATURALIST_API_URL=https://api.inaturalist.org/v1
NEXT_PUBLIC_GBIF_API_URL=https://api.gbif.org/v1
