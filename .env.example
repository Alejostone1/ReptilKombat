# Nombre público de la aplicación (usado en metadatos/branding)
NEXT_PUBLIC_APP_NAME=REPTILES_RPG

# APIs públicas usadas por lib/services/images.ts para obtener fotografías
# reales de reptiles a partir de su nombre científico. Son endpoints públicos
# sin clave de API: las variables existen para poder apuntar a un mirror propio
# o a una futura Cloudflare Worker/proxy sin tocar el código.
NEXT_PUBLIC_WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1/page/summary
NEXT_PUBLIC_WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
NEXT_PUBLIC_INATURALIST_API_URL=https://api.inaturalist.org/v1
NEXT_PUBLIC_GBIF_API_URL=https://api.gbif.org/v1

# --- Supabase (futuro) ---
# Descomenta y completa cuando se migre el roster/habilidades/config a Postgres.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
